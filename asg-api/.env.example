# Vision backend: "ollama" (local) or "gemini" (production)
BACKEND=ollama

# Ollama settings (used when BACKEND=ollama)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llava:7b

# Gemini settings (used when BACKEND=gemini)
GEMINI_API_KEY=

# Storage backend: "local" (development) or "s3" (production)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/tmp/asg_storage

# Base URL for local upload endpoint (used to build presigned-like URLs)
API_BASE_URL=http://localhost:8000
